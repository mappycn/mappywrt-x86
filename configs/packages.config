# ============================================================
# x86_64 固件配置片段（编译时追加到 .config 后再 make defconfig）
# 机型：x86/64 Generic —— Legacy BIOS 引导，产出 combined.img.gz
# 如需增删功能，直接改本文件的 =y / =n，或把某行注释掉即可
# ============================================================

# ---------- 目标平台 ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=n
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=n
CONFIG_TARGET_IMAGES_GZIP=y

# BIOS 引导用 GRUB_IMAGES，EFI 必须关闭，否则会多出一个 -efi 镜像
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=n
CONFIG_ISO_IMAGES=n
CONFIG_VMDK_IMAGES=n
CONFIG_VHDX_IMAGES=n
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=__ROOTFS_SIZE__

# ---------- LuCI 基础 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y

# ---------- sirpdboy 插件体系（EzOpWrt 的核心功能） ----------
CONFIG_PACKAGE_luci-theme-kucat=y
CONFIG_PACKAGE_luci-app-kucat-config=y
CONFIG_PACKAGE_luci-app-advanced=y
CONFIG_PACKAGE_luci-app-advancedplus=y
CONFIG_PACKAGE_luci-app-netwizard=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-lucky=y
# luci-app-netspeedtest 已被 DMCA 下架，取消该项（测速可用 iperf3 或 OpenClash 自带）
CONFIG_PACKAGE_luci-app-taskplan=y
CONFIG_PACKAGE_luci-app-poweroffdevice=y
CONFIG_PACKAGE_luci-app-eqosplus=y
CONFIG_PACKAGE_luci-app-timecontrol=y
CONFIG_PACKAGE_luci-app-watchdog=y

# ---------- 科学上网 ----------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-homeproxy=y
# 若还需要 PassWall，把 diy-part1.sh 里对应行打开并启用下面这行：
# CONFIG_PACKAGE_luci-app-passwall=y

# ---------- 网络与拨号 ----------
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_irqbalance=y
# 上网时间控制用 sirpdboy 的 luci-app-timecontrol（已启用），无需 accesscontrol
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ---------- DNS 去广告 ----------
# ImmortalWrt 24.10 官方源里只有 adguardhome 内核，没有配套 LuCI 界面，
# 需要的话见 README「加 AdGuardHome」一节从第三方源启用。
# CONFIG_PACKAGE_adguardhome=y
# CONFIG_PACKAGE_luci-app-adguardhome=y

# ---------- NAS / 存储 ----------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_luci-app-minidlna=y     # DLNA 媒体共享，不需要可注释
CONFIG_PACKAGE_luci-app-aria2=y        # 离线下载，不需要可注释

# ---------- Docker ----------
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y

# ---------- 网卡与 USB 驱动（N4200 平台必需） ----------
CONFIG_PACKAGE_kmod-igb=y            # Intel i210/i211，N4200 软路由主力网卡
CONFIG_PACKAGE_kmod-e1000e=y         # Intel 千兆/部分 82574
CONFIG_PACKAGE_kmod-r8169=y          # Realtek 8111/8168
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y   # USB 2.5G 网卡
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y

# ---------- 可选：Intel 核显驱动 ----------
# N4200 自带 HD 505，若要在 Docker 里跑 Jellyfin/Emby 硬解再打开
# CONFIG_PACKAGE_kmod-i915=y
# CONFIG_PACKAGE_intel-vaapi-driver=y
