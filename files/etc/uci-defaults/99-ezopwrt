#!/bin/sh
# ============================================================
# EzOpWrt 首次启动默认配置
# 位置：files/etc/uci-defaults/99-ezopwrt
# 只在第一次启动执行一次，执行完自动删除
# ============================================================

# 主机名与时区
uci -q batch <<-EOT
	set system.@system[0].hostname='EzOpWrt'
	set system.@system[0].description='EzOpWrt x86_64 BIOS'
	set system.@system[0].timezone='CST-8'
	set system.@system[0].zonename='Asia/Shanghai'
	set system.ntp.enabled='1'
	delete system.ntp.server
	set system.ntp.server='ntp.aliyun.com'
	add_list system.ntp.server='ntp1.aliyun.com'
	add_list system.ntp.server='cn.pool.ntp.org'
	add_list system.ntp.server='time.cloudflare.com'
EOT

# 局域网地址沿用 EzOpWrt 习惯：192.168.8.1
uci -q batch <<-EOT
	set network.lan.proto='static'
	set network.lan.ipaddr='192.168.8.1'
	set network.lan.netmask='255.255.255.0'
	set dhcp.lan.start='100'
	set dhcp.lan.limit='150'
	set dhcp.lan.leasetime='12h'
EOT

# 默认语言与主题（KuCat）
uci -q set luci.main.lang='zh_cn'
uci -q set luci.main.mediaurlbase='/luci-static/kucat'

uci -q commit system
uci -q commit network
uci -q commit dhcp
uci -q commit luci

# 默认密码 password —— 登录后务必改掉：passwd root
(echo password; echo password) | passwd root >/dev/null 2>&1

exit 0
